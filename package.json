{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "jams2surge",
  "title": "Jams2Surge",
  "description": "Convert Shadowsocks subscriptions to Surge profiles",
  "icon": "extension-icon.png",
  "author": "dangjin",
  "license": "MIT",
  "commands": [
    {
      "name": "convert-subscription",
      "title": "Convert Subscription to Surge",
      "description": "Convert compatible subscription nodes to a Surge profile",
      "mode": "view"
    }
  ],
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@raycast/api": "^1.104.23",
    "@raycast/utils": "^2.3.1",
    "ipaddr.js": "^2.5.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
